<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <!-- A window the system insets for its bars (Android 14 and older, or any build below
             targetSdk 35) never passes the IME inset to the WebView: under adjustNothing its
             visualViewport did not shrink, the kb CSS variable stayed 0 and the keyboard covered the
             sheet's field (measured 2026-10-15, docs/android.md "Soft keyboard"). adjustResize
             shrinks the window there instead. An edge-to-edge window (targetSdk 35+ on Android 15+)
             is never resized; the WebView shrinks its visual viewport and the kb variable takes over. -->
        <item name="android:windowSoftInputMode">adjustResize</item>
        <!-- targetSdk 35+ forces a transparent status bar. Without this the system tints the
             clock/battery icons white and they disappear against our white background. Dark mode
             takes values-night/, which sets it false. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Painted by the system before wry has a surface, i.e. ahead of the in-webview splash in
             index_html(). Defaulting to white made the launch flash white then base-200. #F4F8F6 is
             the sRGB of the color-base-200 token (oklch(97.5% 0.004 165)). -->
        <item name="android:windowBackground">#F4F8F6</item>
    </style>
</resources>
