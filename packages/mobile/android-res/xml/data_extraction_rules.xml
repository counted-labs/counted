<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replaced allowBackup with these rules for cloud backup and device-to-device
  transfer. Excluding everything is deliberate: the app's entire local store is the E2EE key
  material plus ciphertext encrypted under it, and a project key cannot be rotated once copied.
  Matches what iOS does with NSURLIsExcludedFromBackupKey in packages/mobile/src/main.rs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
